{
  "schema_version": 1,
  "error_codes": [
    {
      "code": "protocol.invalid_json",
      "params": [],
      "retryable": false,
      "description": "Request JSON cannot be parsed."
    },
    {
      "code": "protocol.missing_field",
      "params": ["field"],
      "retryable": false,
      "description": "Request is missing a required field."
    },
    {
      "code": "protocol.unknown_method",
      "params": ["method"],
      "retryable": false,
      "description": "Request method is not supported."
    },
    {
      "code": "protocol.version_mismatch",
      "params": ["expected", "actual"],
      "retryable": false,
      "description": "Native app and sidecar IPC protocol versions differ."
    },
    {
      "code": "protocol.invalid_params",
      "params": ["field", "reason"],
      "retryable": false,
      "description": "Request parameters are invalid."
    },
    {
      "code": "file.not_found",
      "params": ["path"],
      "retryable": false,
      "description": "Requested file does not exist."
    },
    {
      "code": "reader.unsupported_format",
      "params": ["path", "suffix"],
      "retryable": false,
      "description": "No sidecar reader is available for the requested file format."
    },
    {
      "code": "reader.open_failed",
      "params": ["path", "reason"],
      "retryable": false,
      "description": "Sidecar reader failed while opening or reading the requested file."
    },
    {
      "code": "reader.session_not_found",
      "params": ["handle"],
      "retryable": false,
      "description": "Requested file session handle does not exist."
    },
    {
      "code": "reader.slice_out_of_range",
      "params": ["handle", "t0", "t1", "duration"],
      "retryable": false,
      "description": "Requested data slice is outside the opened file duration."
    },
    {
      "code": "ipc.sidecar_start_failed",
      "params": ["reason"],
      "retryable": true,
      "description": "Native app could not start the sidecar process."
    },
    {
      "code": "ipc.sidecar_timeout",
      "params": ["operation", "timeout_ms"],
      "retryable": true,
      "description": "Sidecar operation timed out."
    },
    {
      "code": "ipc.sidecar_exited",
      "params": ["exit_code"],
      "retryable": true,
      "description": "Sidecar process exited unexpectedly."
    },
    {
      "code": "sidecar.initialization_failed",
      "params": ["reason"],
      "retryable": true,
      "description": "Sidecar initialization failed."
    },
    {
      "code": "license.missing",
      "params": ["path"],
      "retryable": false,
      "description": "Offline license file is missing."
    },
    {
      "code": "license.invalid_signature",
      "params": ["reason"],
      "retryable": false,
      "description": "Offline license signature verification failed."
    },
    {
      "code": "license.expired",
      "params": ["expires_at"],
      "retryable": false,
      "description": "Offline license is expired."
    },
    {
      "code": "analysis.invalid_input",
      "params": [],
      "retryable": false,
      "description": "Analysis input is invalid."
    },
    {
      "code": "analysis.invalid_channel",
      "params": [],
      "retryable": false,
      "description": "Analysis channel is invalid."
    },
    {
      "code": "analysis.same_channel",
      "params": [],
      "retryable": false,
      "description": "Coherence requires two different channels."
    },
    {
      "code": "analysis.failed",
      "params": [],
      "retryable": false,
      "description": "Analysis failed."
    },
    {
      "code": "internal.unexpected",
      "params": ["operation"],
      "retryable": false,
      "description": "Unexpected internal error."
    }
  ]
}
