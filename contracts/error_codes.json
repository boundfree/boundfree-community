    },
    {
      "code": "csv.invalid_time_axis",
      "params": ["path"],
      "retryable": false,
      "description": "CSV time_s values must be finite and strictly increasing."
    },
    {
      "code": "csv.no_samples",
      "params": ["path"],
      "retryable": false,
