{
  "version": 3,
  "configurePresets": [
    {
      "name": "wsl2-qt6-conda",
      "displayName": "WSL2 Community Qt baseline (Conda)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-qt6-baseline",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/wsl-qt6.cmake"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC 2022 Release",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-windows",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "wsl2-qt6-conda",
      "configurePreset": "wsl2-qt6-conda"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    }
  ]
}
