# Release and packaging artifacts (never commit built binaries or frozen sidecar)
release/
dist/
installer/Output/
*.exe
*.msi

# Sample data
local-samples/public/data/

# Python
*.egg-info/
__pycache__/
.pytest_cache/
*.pyc
.venv/

# Per-machine Windows build and WSL synchronization paths
config/windows-dev.local.json

build-info.json

# Machine-local CMake presets and generated Python bundles
native/CMakeUserPresets.json
sidecar/build/

# Guarded Windows build-mirror state (machine-local)
.boundfree-windows-mirror.json
.boundfree-sync.lock
.boundfree-manifest-*
